# =============================================================================
# Upthrust Portal — environment template
# =============================================================================
# Copy to .env.local and replace every REPLACE_ME. .env.local is gitignored and
# must never be committed. Every value below is a placeholder, not a credential.
# =============================================================================

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal

# Clerk webhook signing secret — Clerk Dashboard → Webhooks → your endpoint.
# REQUIRED. Read by app/api/webhook/clerk/route.ts:35. If this is unset the
# route SKIPS signature verification and trusts the request body, which would
# let anyone link an arbitrary Clerk account to an arbitrary learner email.
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# Server-only. Bypasses row-level security entirely. Never expose to the browser
# and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical portal origin, no trailing slash. Used to build email links and
# Capability Passport verification URLs, so a wrong value here ends up printed
# on issued credentials.
NEXT_PUBLIC_APP_URL=https://REPLACE_ME

# Marketing site origin. Currently read by no code — see docs/DEFERRED.md.
NEXT_PUBLIC_MARKETING_URL=https://REPLACE_ME

# Recurring Zoom link surfaced in session-reminder emails.
# Optional. Read by app/api/notify/route.ts:209.
NEXT_PUBLIC_ZOOM_LINK=

# ── Admin ────────────────────────────────────────────────────────────────────
# The single Clerk user id treated as admin. Copy from Clerk Dashboard → Users
# after the facilitator's first sign-in. If unset, nobody is admin (fail-closed).
ADMIN_USER_ID=user_REPLACE_ME

# ── Capability Passport ──────────────────────────────────────────────────────
# HMAC-SHA256 signing secret for issued passports.
# REQUIRED for issuance and verification. Read by lib/passport.ts:80.
# WARNING: changing this invalidates the signature on every passport already
# issued. Treat it as permanent once the first credential exists.
PASSPORT_SECRET=REPLACE_ME

# ── Anthropic API — AI assignment feedback, simulations, interview coach ─────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Email notifications (Resend — resend.com, free tier: 100/day) ────────────
# Get from https://resend.com/api-keys
# Without this, email is skipped; in-portal notifications still work.
RESEND_API_KEY=re_REPLACE_ME
