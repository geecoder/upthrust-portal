# Clerk Authentication — get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal

# Supabase — get from https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=https://upthrust-site.vercel.app

# Admin — set after Genesis first logs in (copy from Clerk dashboard)
ADMIN_USER_ID=user_REPLACE_AFTER_FIRST_LOGIN

# Anthropic API — for AI assignment feedback
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Email notifications (Resend — resend.com, free tier: 100/day)
# Get from: https://resend.com/api-keys
# Without this, email notifications are skipped (portal notifications still work)
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
